SPRING_APPLICATION_NAME=backend

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/fan_db
SPRING_DATASOURCE_USERNAME=fan_user
SPRING_DATASOURCE_PASSWORD=fan_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=true

SERVER_PORT=8080

POSTGRES_DB=fan_db
POSTGRES_USER=fan_user
POSTGRES_PASSWORD=fan_password